{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build --configLoader runner",
    "preview": "vite preview",
    "dev:worker": "npm run build && wrangler dev --port 8787",
    "dev:worker:remote": "npm run build && wrangler dev --remote --port 8787",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "verify:code-migration": "node scripts/verify-code-migration.mjs",
    "verify:code-docx": "node scripts/verify-code-json-against-docx.mjs",
    "verify:disclosure-guidelines": "node scripts/verify-disclosure-guidelines.mjs",
    "verify:production-disclosure-assets": "node scripts/verify-production-disclosure-assets.mjs",
    "validate:data": "node scripts/validate-data.mjs",
    "search:explain": "node scripts/search-tools.mjs explain",
    "search:report": "node scripts/search-tools.mjs report",
    "test": "node --test",
    "check": "npm run validate:data && npm run verify:disclosure-guidelines && npm test && npm run lint && npm run build && npm run verify:production-disclosure-assets"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dompurify": "^3.3.3",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "^5.7.284",
    "pdfmake": "^0.3.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pdfmake": "^0.3.3",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.2.0",
    "wrangler": "4.124.0"
  }
}
